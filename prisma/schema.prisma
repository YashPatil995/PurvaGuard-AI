generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  role                String               @default("PUBLIC")
  preferredLanguage   String               @default("en")
  status              String               @default("ACTIVE")
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  authoredAlerts      Alert[]
  auditLogs           AuditLog[]
  reports             CommunityReport[]
  authoredContent     ContentPage[]
  incidents           Incident[]
  incidentAssignments IncidentAssignment[]
  authoredNews        NewsItem[]
  authoredTasks       ResponseTask[]
  subscriptions       Subscription[]
  taskAssignments     TaskAssignment[]
  trustedContacts     TrustedContact[]
  lastLocations       UserLastLocation[]
  savedAreas          UserSavedArea[]
  volunteerProfile    VolunteerProfile?
}

model TrustedContact {
  id           String    @id @default(cuid())
  userId       String
  name         String
  relationship String
  phone        String
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSavedArea {
  id        String  @id @default(cuid())
  userId    String
  label     String
  regionId  String?
  lat       Float
  lng       Float
  radiusKm  Float   @default(5)
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserLastLocation {
  id         String   @id @default(cuid())
  userId     String?
  lat        Float
  lng        Float
  accuracyM  Float?
  capturedAt DateTime @default(now())
  expiresAt  DateTime
  consent    String   @default("GRANTED")
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Region {
  id              String               @id @default(cuid())
  parentId        String?
  regionType      String
  canonicalName   String
  stateCode       String?
  localName       String?
  defaultLanguage String               @default("en")
  lat             Float
  lng             Float
  coverageStatus  String               @default("DEMO")
  active          Boolean              @default(true)
  boundarySource  String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  alerts          AlertRegion[]
  facilities      Facility[]
  news            NewsItem[]
  parent          Region?              @relation("RegionHierarchy", fields: [parentId], references: [id])
  children        Region[]             @relation("RegionHierarchy")
  riskPredictions RiskPrediction[]
  weather         WeatherObservation[]
}

model HazardZone {
  id            String    @id @default(cuid())
  regionId      String?
  hazardType    String
  name          String
  lat           Float
  lng           Float
  radiusKm      Float     @default(2)
  baselineLevel String    @default("ADVISORY")
  source        String?
  validFrom     DateTime  @default(now())
  validTo       DateTime?
  version       Int       @default(1)
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
}

model Facility {
  id             String    @id @default(cuid())
  facilityType   String
  name           String
  regionId       String?
  lat            Float
  lng            Float
  address        String?
  phone          String?
  capacity       Int?
  availableUnits Int?
  accessibility  String?
  hours          String?
  status         String    @default("OPEN")
  verifiedAt     DateTime?
  source         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  region         Region?   @relation(fields: [regionId], references: [id])
}

model RoadSegment {
  id           String    @id @default(cuid())
  name         String
  lat          Float
  lng          Float
  roadClass    String    @default("HIGHWAY")
  status       String    @default("OPEN")
  restrictions String?
  source       String?
  verifiedAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model DataSource {
  id                     String    @id @default(cuid())
  name                   String
  sourceType             String
  provider               String
  refreshIntervalMinutes Int       @default(15)
  enabled                Boolean   @default(true)
  healthStatus           String    @default("HEALTHY")
  lastSuccessAt          DateTime?
  lastErrorAt            DateTime?
  lastErrorMessage       String?
  simulationMode         Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model WeatherObservation {
  id            String   @id @default(cuid())
  regionId      String?
  stationName   String?
  lat           Float?
  lng           Float?
  observedAt    DateTime @default(now())
  rainfall24hMm Float    @default(0)
  rainfall1hMm  Float    @default(0)
  temperatureC  Float    @default(20)
  humidityPct   Float    @default(60)
  windKph       Float    @default(10)
  demoLabel     Boolean  @default(true)
  region        Region?  @relation(fields: [regionId], references: [id])
}

model RiskPrediction {
  id              String   @id @default(cuid())
  regionId        String?
  lat             Float
  lng             Float
  hazardType      String
  horizonMinutes  Int      @default(360)
  riskLevel       String
  riskScore       Float
  confidence      Float
  dataCoveragePct Float
  topFeatures     String?
  inputSnapshot   String?
  modelVersion    String   @default("purvaguard-baseline-v1")
  generatedAt     DateTime @default(now())
  expiresAt       DateTime
  simulationMode  Boolean  @default(true)
  region          Region?  @relation(fields: [regionId], references: [id])
}

model Alert {
  id                 String                 @id @default(cuid())
  alertType          String
  issuerType         String                 @default("PLATFORM")
  issuerName         String
  title              String
  body               String
  severity           String
  modelRiskLevel     String?
  confidence         Float?
  sourceUrl          String?
  lat                Float?
  lng                Float?
  radiusKm           Float                  @default(10)
  issuedAt           DateTime               @default(now())
  validFrom          DateTime               @default(now())
  expiresAt          DateTime
  status             String                 @default("ACTIVE")
  verificationStatus String                 @default("PLATFORM")
  languages          String                 @default("en,hi,ne,as")
  approvedBy         String?
  publishedAt        DateTime?
  simulationMode     Boolean                @default(true)
  version            Int                    @default(1)
  authorId           String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  author             User?                  @relation(fields: [authorId], references: [id])
  regions            AlertRegion[]
  deliveries         NotificationDelivery[]
}

model AlertRegion {
  id       String @id @default(cuid())
  alertId  String
  regionId String
  region   Region @relation(fields: [regionId], references: [id])
  alert    Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)
}

model Subscription {
  id           String   @id @default(cuid())
  userId       String?
  regionId     String?
  label        String?
  hazards      String   @default("LANDSLIDE,FLASH_FLOOD,HEAVY_RAIN")
  channels     String   @default("IN_APP")
  soundEnabled Boolean  @default(false)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationDelivery {
  id             String    @id @default(cuid())
  alertId        String?
  incidentId     String?
  recipient      String
  channel        String
  provider       String?
  status         String    @default("QUEUED")
  queuedAt       DateTime  @default(now())
  sentAt         DateTime?
  deliveredAt    DateTime?
  attempts       Int       @default(0)
  simulationMode Boolean   @default(true)
  alert          Alert?    @relation(fields: [alertId], references: [id], onDelete: Cascade)
}

model Incident {
  id                 String               @id @default(cuid())
  incidentCode       String               @unique
  incidentType       String
  priority           String               @default("NORMAL")
  status             String               @default("NEW")
  description        String
  lat                Float
  lng                Float
  locationAccuracyM  Float?
  locationCapturedAt DateTime             @default(now())
  locationKind       String               @default("GPS")
  peopleCount        Int                  @default(1)
  needs              String?
  reporterUserId     String?
  reporterContact    String?
  consentSnapshot    String?
  sourceChannel      String               @default("WEB")
  verificationStatus String               @default("UNVERIFIED")
  assignedTeamId     String?
  simulationMode     Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  closedAt           DateTime?
  reporter           User?                @relation(fields: [reporterUserId], references: [id])
  assignments        IncidentAssignment[]
  attachments        IncidentAttachment[]
  events             IncidentEvent[]
}

model IncidentAttachment {
  id         String   @id @default(cuid())
  incidentId String
  objectKey  String
  mediaType  String
  sizeBytes  Int
  uploadedAt DateTime @default(now())
  visibility String   @default("INTERNAL")
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model IncidentEvent {
  id         String   @id @default(cuid())
  incidentId String
  actorId    String?
  eventType  String
  fromStatus String?
  toStatus   String?
  note       String?
  payload    String?
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model IncidentAssignment {
  id          String    @id @default(cuid())
  incidentId  String
  volunteerId String?
  assignedBy  String
  assignedAt  DateTime  @default(now())
  acceptedAt  DateTime?
  completedAt DateTime?
  status      String    @default("ASSIGNED")
  note        String?
  volunteer   User?     @relation(fields: [volunteerId], references: [id])
  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model CommunityReport {
  id                 String   @id @default(cuid())
  category           String
  description        String
  lat                Float
  lng                Float
  severity           String   @default("MODERATE")
  status             String   @default("RECEIVED")
  reporterUserId     String?
  observedAt         DateTime @default(now())
  verificationStatus String   @default("UNVERIFIED")
  simulationMode     Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  reporter           User?    @relation(fields: [reporterUserId], references: [id])
}

model VolunteerProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  organizationId     String?
  skills             String    @default("")
  languages          String    @default("en")
  serviceRegions     String    @default("")
  availabilityStatus String    @default("AVAILABLE")
  equipment          String?
  vehicle            String?
  training           String?
  verificationStatus String    @default("PENDING")
  approvedBy         String?
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResponseTask {
  id                String           @id @default(cuid())
  title             String
  taskType          String
  description       String
  lat               Float
  lng               Float
  regionId          String?
  requiredSkills    String           @default("")
  capacity          Int              @default(1)
  status            String           @default("OPEN")
  coordinatorId     String?
  startAt           DateTime?
  endAt             DateTime?
  safetyConstraints String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  coordinator       User?            @relation(fields: [coordinatorId], references: [id])
  assignments       TaskAssignment[]
}

model TaskAssignment {
  id             String       @id @default(cuid())
  taskId         String
  volunteerId    String
  status         String       @default("ASSIGNED")
  assignedAt     DateTime     @default(now())
  acceptedAt     DateTime?
  checkinAt      DateTime?
  checkoutAt     DateTime?
  completionNote String?
  volunteer      User         @relation(fields: [volunteerId], references: [id])
  task           ResponseTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model NewsItem {
  id          String   @id @default(cuid())
  title       String
  summary     String
  publisher   String
  sourceUrl   String
  publishedAt DateTime @default(now())
  fetchedAt   DateTime @default(now())
  regionId    String?
  categories  String   @default("GENERAL")
  language    String   @default("en")
  status      String   @default("PUBLISHED")
  pinned      Boolean  @default(false)
  aiSummary   String?
  demoLabel   Boolean  @default(true)
  authorId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      User?    @relation(fields: [authorId], references: [id])
  region      Region?  @relation(fields: [regionId], references: [id])
}

model ContentPage {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  body         String
  contentType  String
  hazardType   String?
  language     String    @default("en")
  version      Int       @default(1)
  status       String    @default("PUBLISHED")
  reviewedBy   String?
  reviewedAt   DateTime?
  nextReviewAt DateTime?
  authorId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  author       User?     @relation(fields: [authorId], references: [id])
}

model MediaAsset {
  id               String   @id @default(cuid())
  url              String
  altText          String
  caption          String?
  credit           String?
  sourceUrl        String?
  moderationStatus String   @default("APPROVED")
  uploadedBy       String?
  createdAt        DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     String?
  after      String?
  ipHash     String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Feedback {
  id         String    @id @default(cuid())
  category   String
  message    String
  pagePath   String?
  status     String    @default("OPEN")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model SmsRecipient {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SmsLog {
  id               String    @id @default(cuid())
  phone            String
  message          String
  status           String    @default("QUEUED")
  provider         String    @default("textbelt")
  providerResponse String?
  alertId          String?
  incidentId       String?
  verificationId   String?
  simulationMode   Boolean   @default(false)
  sentAt           DateTime  @default(now())
  deliveredAt      DateTime?
}

model DisasterVerification {
  id          String   @id @default(cuid())
  reportId    String?
  incidentId  String?
  inputText   String
  analysis    String
  verified    Boolean  @default(false)
  actionTaken String?
  alertId     String?
  createdAt   DateTime @default(now())
}

model Translation {
  id        String   @id @default(cuid())
  key       String
  language  String
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([key, language])
}
